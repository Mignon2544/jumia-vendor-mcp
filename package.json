{
  "name": "jumia-vendor-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Jumia Vendor Center GPM (catalog) and GOP (orders) APIs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/http-server.ts",
    "start:stdio": "node src/server.ts",
    "setup": "node src/setup.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "adm-zip": "^0.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.0.0",
    "multer": "^2.5.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  }
}
